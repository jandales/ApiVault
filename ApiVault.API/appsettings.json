{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "ApiVault",
    "Audience": "ApiVault.Web",
    "Key": "",
    "AccessTokenMinutes": 10,
    "RefreshTokenDays": 14
  },
  "Auth": {
    "RequireConfirmedEmail": true,
    "FrontendUrl": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "AuthWindowSeconds": 60
  }
}
